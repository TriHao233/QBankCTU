APP_NAME=QBankCTU API
APP_VERSION=0.2.0
APP_ENV=development
# Demo login is disabled unless explicitly enabled.
DEMO_MODE=false
# Set these only in a local/demo environment when DEMO_MODE=true.
DEMO_ADMIN_EMAIL=admin@qbankctu.edu.vn
DEMO_ADMIN_PASSWORD=
DEMO_REVIEWER_EMAIL=reviewer@qbankctu.edu.vn
DEMO_REVIEWER_PASSWORD=
DEMO_TEACHER_EMAIL=teacher@qbankctu.edu.vn
DEMO_TEACHER_PASSWORD=
DEMO_SESSION_SECRET=
DEMO_SESSION_TTL_HOURS=8
HOST=0.0.0.0
PORT=8000
ANONYMIZED_TELEMETRY=False

MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
AUTH_DB_NAME=NCKH
RAG_DB_NAME=rag_database
MONGO_CONNECT_TIMEOUT_MS=10000
# PostgreSQL holds all business data; MongoDB keeps only chunk/vector data for RAG.
# Set this to the database accessible from the backend process, then run
# `python -m db.migrate --apply` (and copy existing Mongo data, see README section 12).
POSTGRES_DSN=postgresql://nckh:nckh_local_dev_only@localhost:5432/nckh
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
# Business data stores. Default is postgres; "mongo" routes a group back to MongoDB
# (rollback only). An environment whose data has not been copied to PostgreSQL yet
# MUST keep every flag at mongo until its cutover (docs/CUTOVER_RUNBOOK.md).
# Dependencies: CATALOG/NOTIFICATION/MOODLE_TARGET/REVIEW_POLICY need USER;
# DOCUMENT and QUESTION need USER + CATALOG; GENERATION needs USER + DOCUMENT;
# EXAM needs QUESTION + CATALOG.
USER_STORE=postgres
AI_CONFIG_STORE=postgres
CATALOG_STORE=postgres
NOTIFICATION_STORE=postgres
DICTIONARY_STORE=postgres
MOODLE_TARGET_STORE=postgres
LLM_SLOT_STORE=postgres
DOCUMENT_STORE=postgres
AUDIT_STORE=postgres
REVIEW_POLICY_STORE=postgres
QUESTION_STORE=postgres
GENERATION_STORE=postgres
EXAM_STORE=postgres
# Production/staging must use a replica set so multi-document writes stay atomic.
REQUIRE_MONGO_TRANSACTIONS=false
JOB_RECOVERY_TIMEOUT_MINUTES=120
JOB_WORKER_POLL_SECONDS=1
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=300
MAX_ACTIVE_GENERATION_JOBS_PER_USER=10
WORKER_SHUTDOWN_GRACE_SECONDS=30
JOB_RETENTION_DAYS=90
LLM_SLOT_LEASE_SECONDS=90
LLM_SLOT_HEARTBEAT_SECONDS=15
LLM_SLOT_WAIT_TIMEOUT_SECONDS=600
LLM_SLOT_POLL_SECONDS=0.5
OLLAMA_MAX_CONCURRENCY=1
GENERATION_BATCH_SIZE=3
OLLAMA_GENERATION_BATCH_SIZE=1
GEMINI_MAX_CONCURRENCY=5
REVIEW_LOCK_TIMEOUT_MINUTES=30
REVIEW_ASSIGNMENT_TIMEOUT_HOURS=72
REVIEW_SLA_HOURS=48
REVIEW_SLA_REMINDER_INTERVAL_SECONDS=900
GPU_COORDINATION_ENABLED=true
GPU_LOCK_PATH=./data/gpu-operation.lock
GPU_LOCK_TIMEOUT_SECONDS=1200
GPU_LOCK_STALE_SECONDS=120
GPU_LOCK_HEARTBEAT_SECONDS=10
GPU_LOCK_POLL_SECONDS=0.25

FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=nckh-e6817

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
API_PREFIX=/api/v1

MODEL_PROVIDER=qwen3-8b
CODE_GENERATION_MODEL_PROVIDER=qwen3-8b
EVALUATION_MODEL_PROVIDER=qwen3-8b
EVALUATION_NUM_PREDICT=1400
EVALUATION_RETRY_NUM_PREDICT=1800
EVALUATION_THINKING_NUM_PREDICT=4096
EVALUATION_THINKING_NUM_CTX=12288
GENERATION_FALLBACK_PROVIDER=
EVALUATION_FALLBACK_PROVIDER=
OLLAMA_GENERATE_URL=http://localhost:11434/api/generate
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0
DEEPSEEK_MODEL_NAME=deepseek-r1
GEMINI_API_KEY=
# To make Gemini the default generator, set MODEL_PROVIDER=gemini.
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=5m
PROMPT_SOURCE=file
CHROMADB_COLLECTION_NAME=chunks
LEXICAL_FALLBACK_MAX_CHUNKS=1200
LEXICAL_FALLBACK_DISTANCE_THRESHOLD=0.55
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# Empty means the model repository default revision.
EMBEDDING_MODEL_REVISION=
# auto selects FP16 on CUDA and FP32 on CPU.
EMBEDDING_PRECISION=auto
EMBEDDING_BATCH_SIZE=16
# Maximum padded tokens per adaptive GPU batch.
EMBEDDING_BATCH_MAX_TOKENS=8192
EMBEDDING_MAX_TOKENS=1024
EMBEDDING_TOKEN_OVERLAP=128
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_RELEASE_GPU_AFTER_USE=true

# docling (default) or easyocr. No automatic OCR fallback between engines.
PDF_OCR_ENGINE=docling
DOCLING_URL=http://localhost:5001
DOCLING_OCR_PRESET=tesseract
DOCLING_OCR_LANGUAGES=vie
DOCLING_TIMEOUT=600

# EasyOCR + PDFium (existing setup)
EASYOCR_LANGUAGES=vi,en
EASYOCR_GPU=true
EASYOCR_BATCH_SIZE=2
EASYOCR_RENDER_SCALE=2.0
EASYOCR_MIN_CONFIDENCE=0.20
# Stored under backend/data (bind-mounted from drive D in Docker Compose).
EASYOCR_MODEL_STORAGE_DIRECTORY=./data/easyocr_models
EASYOCR_DOWNLOAD_ENABLED=true
# Release EasyOCR VRAM after each document so Ollama can use the 6 GB GPU.
EASYOCR_UNLOAD_AFTER_USE=true

# Use direct PDF text extraction only when the quality gate accepts every condition.
PDF_TEXT_FAST_PATH_ENABLED=true
PDF_TEXT_FAST_PATH_MIN_COVERAGE=0.98
PDF_TEXT_FAST_PATH_MIN_CHARS_PER_PAGE=150
PDF_TEXT_FAST_PATH_MAX_IMAGE_PAGE_RATIO=0.0
PDF_TEXT_FAST_PATH_MAX_REPLACEMENT_RATIO=0.005

CHROMADB_PATH=./data/chroma_data
# Use http for a shared Chroma server when API and workers run on separate hosts.
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
# Optional bearer token; store its value in environment/secret manager, never in DB.
CHROMA_AUTH_TOKEN=
UPLOAD_DIR=./data/uploads
OCR_OUTPUT_DIR=./data/ocr_outputs
RAW_ARTIFACT_COMPRESSION=gzip
ARTIFACT_HOT_RETENTION_DAYS=30
ARTIFACT_COLD_RETENTION_DAYS=365
ARTIFACT_COLD_DIR=./data/artifact_archive
ARTIFACT_BLOB_DIR=./data/artifact_blobs
# New uploads, OCR artifacts and avatars: local | s3 (S3-compatible: AWS, MinIO, R2, GCS).
# Existing files are always read from the provider recorded with them.
# Credentials use the standard AWS chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY,
# profile or workload identity); never put them in the database.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_PREFIX=
S3_ENDPOINT_URL=
S3_REGION=
